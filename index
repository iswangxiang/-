        function renderFoods() {
            const grid = document.getElementById('foodGrid');
            const data = getFilteredData();
            
            if (data.length === 0) {
                grid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; color:#888; padding: 40px;">当前分类暂无菜品</div>';
                return;
            }
            grid.innerHTML = data.map(item => `
                <div class="food-card" onclick="showModal(${item.id})">
                    <img src="${item.img}" alt="${item.name}" class="food-img" loading="lazy">
                    <div class="food-info">
                        <div class="food-name">${item.name}</div>
                    </div>
                </div>
            `).join('');
        }

        function showModal(id, titleText = null) {
            const item = dbData.find(d => d.id === id);
            if (!item) return;

            // 显示是第几次抽签
            const titleEl = document.getElementById('spinResultTitle');
            if(titleText) {
                titleEl.innerText = titleText;
                titleEl.style.display = "block";
            } else {
                titleEl.style.display = "none";
            }

            document.getElementById('modalName').innerText = item.name;
            document.getElementById('modalPrice').innerText = item.price;
            document.getElementById('modalStore').innerText = item.store;
            document.getElementById('modalLocation').innerText = item.location;
            
            document.getElementById('detailModal').classList.add('show');
        }

        function closeModal(event, force = false) {
            if (force || event.target.id === 'detailModal') {
                document.getElementById('detailModal').classList.remove('show');
                
                // 如果刚好关掉的是第3次抽签的弹窗，立刻触发终极抉择
                if (spinCount >= maxSpins) {
                    setTimeout(() => { showFinalSelection(); }, 300);
                }
            }
        }

        // 老虎机算法
        function pickRandom() {
            if (isSpinning) return;
            if (spinCount >= maxSpins) {
                alert("你已经抽取3次啦！无法再重抽。");
                showFinalSelection();
                return;
            }

            const currentData = getFilteredData();
            if (currentData.length === 0) {
                alert("当前分类下没有可以随机的菜品哦！");
                return;
            }

            isSpinning = true;
            const btn = document.getElementById('randomBtn');
            btn.innerText = "🎰 正在摇号中...";
            btn.disabled = true;

            const slotOverlay = document.getElementById('slotOverlay');
            const slotWindow = document.getElementById('slotWindow');

            const spinRounds = 4;
            let rollData = [{ name: "等待命运降临..." }];
            
            for (let i = 0; i < spinRounds; i++) {
                rollData = rollData.concat(currentData);
            }
            
            const winnerIndex = Math.floor(Math.random() * currentData.length);
            const finalWinner = currentData[winnerIndex];
            
            for (let i = 0; i <= winnerIndex; i++) {
                rollData.push(currentData[i]);
            }
            rollData.push({ name: "" });

            slotWindow.innerHTML = rollData.map(item => `<div class="slot-item">${item.name}</div>`).join('');
            slotWindow.style.transition = 'none';
            slotWindow.style.transform = `translateY(0px)`;
            
            slotOverlay.classList.add('show');
            slotWindow.offsetHeight; // 强制渲染

            const targetIndex = 1 + spinRounds * currentData.length + winnerIndex;
            const targetY = - (targetIndex - 1) * 60;

            slotWindow.style.transition = 'transform 3s cubic-bezier(0.1, 0.7, 0.1, 1)';
            slotWindow.style.transform = `translateY(${targetY}px)`;

            // 动画结束
            setTimeout(() => {
                slotOverlay.classList.remove('show');
                
                // ✨ 将本次结果保存进数组，并增加计数
                spinResults.push(finalWinner);
                spinCount++;
                
                // 弹出单次结果
                showModal(finalWinner.id, `第 ${spinCount} 次抽取结果`);
                
                // 恢复按钮并更新剩余次数
                isSpinning = false;
                if (spinCount < maxSpins) {
                    btn.innerText = `🎰 老虎机抽签 (剩余${maxSpins - spinCount}次)`;
                    btn.disabled = false;
                } else {
                    btn.innerText = `🛑 次数已用完`;
                    btn.style.background = "#cccccc";
                }
            }, 3200);
        }

        // ✨ 触发终极抉择阶段
        function showFinalSelection() {
            // 如果已经显示了，就不重复执行
            if(document.getElementById('finalSelectionModal').classList.contains('show')) return;
            
            document.getElementById('finalSelectionModal').classList.add('show');
            
            const container = document.getElementById('finalOptionsContainer');
            // 将3次结果渲染成列表
            container.innerHTML = spinResults.map((item, index) => `
                <div class="mini-card" onclick="makeFinalChoice(${index})">
                    <img src="${item.img}" class="food-img">
                    <div class="food-info">
                        <div class="food-name">${item.name}</div>
                        <div style="font-size:12px; color:#888;">${item.store} | ${item.price}</div>
                    </div>
                </div>
            `).join('');

            // 初始化倒计时
            timeLeft = 8;
            document.getElementById('countdownText').innerText = timeLeft;
            document.getElementById('finalTitle').innerText = "⚔️ 终极对决 ⚔️";
            document.getElementById('countdownDisplay').style.display = 'block';

            // 开始8秒计时器
            finalTimer = setInterval(() => {
                timeLeft--;
                if (timeLeft > 0) {
                    document.getElementById('countdownText').innerText = timeLeft;
                } else {
                    // 超时未选
                    clearInterval(finalTimer);
                    unlockHiddenOption();
                }
            }, 1000);
        }

        // ✨ 用户做出了最终选择
        function makeFinalChoice(index) {
            if (timeLeft <= 0) return; // 超时就不让点了
            
            clearInterval(finalTimer); // 停止倒计时
            const chosen = spinResults[index];
            
            // 更新 UI
            document.getElementById('finalTitle').innerText = "✅ 最终决定就是它了！";
            document.getElementById('countdownDisplay').style.display = 'none';

            // 清空列表，只展示那一个大卡片
            const container = document.getElementById('finalOptionsContainer');
            container.innerHTML = `
                <div class="mini-card" style="transform: scale(1.05); margin: 20px auto; border-color: var(--primary-color); cursor: default;">
                    <img src="${chosen.img}" class="food-img" style="width: 110px; height: 110px;">
                    <div class="food-info" style="padding: 15px;">
                        <div style="font-size: 18px; font-weight: bold; margin-bottom: 6px;">${chosen.name}</div>
                        <div style="font-size: 14px; color: var(--text-sub); margin-bottom: 4px;">${chosen.store} | ${chosen.price}</div>
                        <div style="font-size: 12px; color: #aaa;">${chosen.location}</div>
                    </div>
                </div>
                <div style="margin-top:20px; color:#888; font-size:14px;">祝你用餐愉快！</div>
                <button class="btn-restart" onclick="resetApp()">再来一轮</button>
            `;
        }

        // ✨ 超时触发彩蛋
        function unlockHiddenOption() {
            document.getElementById('finalTitle').innerText = "✨ 隐藏选项解锁 ✨";
            document.getElementById('countdownDisplay').style.display = 'none';
            
            const container = document.getElementById('finalOptionsContainer');
            container.innerHTML = `
                <div class="hidden-option-box">
                    <div style="font-size: 55px; margin-bottom: 10px;">🦀</div>
                    <div style="font-size: 26px; font-weight: bold; color: var(--primary-color); margin-bottom: 10px;">249 海鲜自助</div>
                    <div style="font-size: 14px; color: #666; line-height:1.5;">
                        既然给了你3次机会你都犹豫不决...<br>那就不要选了，对自己好一点！
                    </div>
                </div>
                <div style="margin-top:20px; color:#888; font-size:14px;">老板，买单！</div>
                <button class="btn-restart" onclick="resetApp()">再来一轮</button>
            `;
        }

        function resetApp() {
            if (finalTimer) {
                clearInterval(finalTimer);
                finalTimer = null;
            }

            isSpinning = false;
            spinCount = 0;
            spinResults = [];
            timeLeft = 8;

            document.getElementById('detailModal').classList.remove('show');
            document.getElementById('slotOverlay').classList.remove('show');
            document.getElementById('finalSelectionModal').classList.remove('show');
            document.getElementById('finalOptionsContainer').innerHTML = '';
            document.getElementById('countdownText').innerText = timeLeft;
            document.getElementById('finalTitle').innerText = "⚔️ 终极对决 ⚔️";
            document.getElementById('countdownDisplay').style.display = 'block';

            const btn = document.getElementById('randomBtn');
            btn.innerText = `🎰 老虎机抽签 (剩余${maxSpins}次)`;
            btn.disabled = false;
            btn.style.background = '';

            renderNav();
            renderFoods();
        }

        window.onload = init;
    </script>
</body>
</html>
